<?xml version="1.0"?>
<N10X>
	<Workspace>
		<IncludeFilter>*.*,</IncludeFilter>
		<ExcludeFilter>*.obj,*.o,*.d,*.lib,*.a,*.so,*.exp,*.ilk,*.pch,*.dll,*.pdb,*.exe,*.builder-dependencies,*.rebuild.old,*.user,.vs,.git,.claude,.builder,intermediate,bin,x64,Debug,Release,visual_studio,releases,bug_reports,tools,VisualC,VisualC-GDK,Xcode,android-project,build-scripts,cmake,wayland-protocols,</ExcludeFilter>
		<SyncFiles>true</SyncFiles>
		<Recursive>true</Recursive>
		<ShowEmptyFolders>false</ShowEmptyFolders>
		<IncludeFilesWithoutExt>false</IncludeFilesWithoutExt>
		<IsFolder>false</IsFolder>
		<UseVisualStudioEnvBat>true</UseVisualStudioEnvBat>
		<CaptureExeOutput>true</CaptureExeOutput>
		<AllowAutoErrorUnderlining>true</AllowAutoErrorUnderlining>
		<Configurations>
			<Configuration>Debug</Configuration>
		</Configurations>
		<Platforms>
			<Platform>x64</Platform>
		</Platforms>
		<AdditionalIncludePaths>
			<AdditionalIncludePath>C:\dev\Builder_dev</AdditionalIncludePath>
			<AdditionalIncludePath>C:\dev\Builder_dev\tests</AdditionalIncludePath>
			<AdditionalIncludePath>C:\dev\Builder_dev\tests\sdl3\include</AdditionalIncludePath>
			<AdditionalIncludePath>C:\dev\Builder_dev\tests\sdl3\include\build_config</AdditionalIncludePath>
			<AdditionalIncludePath>C:\Program Files\Microsoft Visual Studio\2022\Community\VC\Tools\MSVC\14.44.35207\include</AdditionalIncludePath>
			<AdditionalIncludePath>C:\Program Files\Microsoft Visual Studio\2022\Community\VC\Tools\MSVC\14.44.35207\ATLMFC\include</AdditionalIncludePath>
			<AdditionalIncludePath>C:\Program Files\Microsoft Visual Studio\2022\Community\VC\Auxiliary\VS\include</AdditionalIncludePath>
			<AdditionalIncludePath>C:\Program Files (x86)\Windows Kits\10\include\10.0.26100.0\ucrt</AdditionalIncludePath>
			<AdditionalIncludePath>C:\Program Files (x86)\Windows Kits\10\include\10.0.26100.0\um</AdditionalIncludePath>
			<AdditionalIncludePath>C:\Program Files (x86)\Windows Kits\10\include\10.0.26100.0\shared</AdditionalIncludePath>
			<AdditionalIncludePath>C:\Program Files (x86)\Windows Kits\10\include\10.0.26100.0\winrt</AdditionalIncludePath>
			<AdditionalIncludePath>C:\Program Files (x86)\Windows Kits\10\include\10.0.26100.0\cppwinrt</AdditionalIncludePath>
			<AdditionalIncludePath>C:\Program Files (x86)\Windows Kits\NETFXSDK\4.8\include\um</AdditionalIncludePath>
		</AdditionalIncludePaths>
		<Defines>
			<Define>_WIN32</Define>
			<Define>_WIN64</Define>
			<Define>__clang__</Define>
			<Define>_CRT_SECURE_NO_WARNINGS</Define>
			<Define>BUILDER_IMPLEMENTATION</Define>
			<Define>BUILDER_VISUAL_STUDIO_IMPLEMENTATION</Define>
			<Define>BUILDER_VS_CODE_IMPLEMENTATION</Define>
			<Define>BUILDER_ZED_IMPLEMENTATION</Define>
			<Define>BUILDER_COMPILATION_DATABASE_IMPLEMENTATION</Define>
			<Define>TEMPER_IMPLEMENTATION</Define>
			<Define>BUILDER_10X_IMPLEMENTATION</Define>
		</Defines>
		<ConfigProperties>
			<ConfigAndPlatform>
				<Name>Debug:x64</Name>
				<BuildCommand>cmd /c (if not exist build_tests.exe clang -o build_tests.exe build_tests.c) &amp;&amp; .\build_tests.exe</BuildCommand>
				<RebuildCommand>cmd /c (if exist intermediate rmdir /s /q intermediate) &amp; (if exist builder_tests.exe del /q builder_tests.exe) &amp; clang -o build_tests.exe build_tests.c &amp;&amp; .\build_tests.exe</RebuildCommand>
				<BuildFileCommand></BuildFileCommand>
				<CleanCommand>cmd /c (if exist intermediate rmdir /s /q intermediate) &amp; (if exist builder_tests.exe del /q builder_tests.exe)</CleanCommand>
				<BuildWorkingDirectory>C:\dev\Builder_dev\tests</BuildWorkingDirectory>
				<FileSyntaxCheckCommand></FileSyntaxCheckCommand>
				<CancelBuild></CancelBuild>
				<Exe>C:\dev\Builder_dev\tests\builder_tests.exe</Exe>
				<Args></Args>
				<WorkingDirectory>C:\dev\Builder_dev\tests</WorkingDirectory>
				<DebugCommand>$(Executable)</DebugCommand>
				<DebuggerExe>C:\dev\raddebugger\build\raddbg.exe --auto_run $(Executable)</DebuggerExe>
				<DebugSln></DebugSln>
				<Defines></Defines>
				<ForceIncludes></ForceIncludes>
				<PrioritiseFiles></PrioritiseFiles>
			</ConfigAndPlatform>
			<Config>
				<Name>Debug</Name>
				<Defines></Defines>
			</Config>
			<Platform>
				<Name>x64</Name>
				<Defines></Defines>
			</Platform>
		</ConfigProperties>
		<TerminalDirectory>$(WorkspaceDirectory)</TerminalDirectory>
		<Children></Children>
	</Workspace>
</N10X>
